# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.shots/
.shots-dev.log
_masters/

# Local working media that must NEVER enter the repo (a stray `git add -A` once
# staged a 245MB .af source file and GitHub's 100MB pre-receive hook rejected the
# push). Masters/originals live in _masters/ or outside the repo; only optimized,
# actually-referenced assets get committed to public/.
*.af
*OLD.*
* - Copy.*
*-master.mp4
